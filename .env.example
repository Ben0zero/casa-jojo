# Plantilla del .env de La Casa JoJo. Copia este archivo como .env (ignorado por Git)
# y completa los valores. Lo usan docker-compose.yml y scripts/demo-oracle.ps1.

# --- Oracle Cloud ---
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_SERVICE=clases_high
# Carpeta del wallet en TU equipo, con barras / (ej.: C:/Users/tu_usuario/OracleWallet).
# Docker la monta como solo lectura en /wallet.
TNS_ADMIN=

# --- JWT: mínimo 32 caracteres, el MISMO para los tres servicios ---
JWT_SECRET=

# --- Retiro con QR (opcional). El QR de la tienda es: casajojo://retiro?codigo=<RETIRO_CODIGO> ---
# RETIRO_CODIGO=CASAJOJO-RETIRO

# --- Correo para recuperar la contraseña (opcional) ---
# Si SMTP_HOST queda vacío, ms-auth trabaja en modo "log": escribe el código en la
# consola (docker compose logs ms-auth). Ej. Gmail: smtp.gmail.com, puerto 587 y una
# "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
