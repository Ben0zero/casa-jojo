<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recurso nativo: notificaciones locales del estado del pedido.
         Obligatorio declararlo desde Android 13 (API 33); en versiones
         anteriores se ignora. El permiso se solicita en runtime desde
         la pantalla de Retiro (PedirPermisoNotificaciones). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- EA3 / IL3.1: necesario para llamar a los microservicios por Retrofit. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 17 (API 37): permiso de red local. Sin él, la app no puede conectarse a
         los microservicios en 10.0.2.2 (emulador) ni en la IP de la PC (celular físico).
         Se pide en tiempo de ejecución (ver PedirPermisoRedLocal). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- B3: sin respaldo automático (la base local y el token JWT no salen del teléfono).
         M14: HTTP sin cifrar solo hacia los microservicios locales (ver res/xml). -->
    <application
        android:name=".CasaJojoApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CasaJojo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
